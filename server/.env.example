# Copy to server/.env for local development, or set these as app environment
# variables in CapRover. Nothing here is secret in the example — the real
# values are.

# Required. Postgres connection string.
# CapRover one-click Postgres gives you an internal hostname like
# srv-captain--postgres, reachable from other apps on the same CapRover node.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/procedural_terrain

# Where the frontend is served from. Must name the origin exactly — the session
# cookie is credentialed, and browsers reject wildcard CORS origins on
# credentialed requests.
CORS_ORIGIN=http://localhost:5173

# Set to "production" in a real deploy. Controls whether the session cookie is
# marked Secure (which a plain-HTTP localhost dev server could never send back).
NODE_ENV=development

PORT=3000
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# Optional, defaults to "lax" — right for the normal CapRover layout where the
# frontend and API are subdomains of one registrable domain. One of: lax,
# strict, none. "none" requires NODE_ENV=production (so the cookie is also
# Secure) or the server refuses to start — browsers silently drop
# SameSite=None cookies that aren't also Secure, so that combination would
# otherwise boot looking fine and just never keep anyone signed in.
COOKIE_SAMESITE=lax

# Optional. Without it the server still boots and everything else still
# works — /auth/forgot-password just logs a warning instead of sending an
# email, and always returns { ok: true } to the caller either way (so it
# never reveals whether it actually sent anything).
RESEND_API_KEY=
# Resend's shared sending domain works with zero DNS setup — fine to start
# with, but it can ONLY deliver to the address that owns the Resend account.
# Every other recipient is refused with a 403 that never reaches the browser
# (/auth/forgot-password always answers { ok: true } so it can't be used to
# enumerate accounts), so a real password reset silently goes nowhere. The
# server warns about this at boot whenever RESEND_API_KEY is also set.
#
# To actually send mail: verify a domain at resend.com/domains, add the DNS
# records it gives you, then set this to an address on that domain.
#
# If you get locked out before that is sorted, `npm run reset-link -- <email>`
# prints a working reset link without needing email at all.
EMAIL_FROM=Procedural Terrain <onboarding@resend.dev>

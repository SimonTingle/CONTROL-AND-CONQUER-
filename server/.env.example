# Copy to server/.env for local development, or set these as app environment
# variables in CapRover. Nothing here is secret in the example — the real
# values are.

# Required. Postgres connection string.
# CapRover one-click Postgres gives you an internal hostname like
# srv-captain--postgres, reachable from other apps on the same CapRover node.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/procedural_terrain

# Where the frontend is served from. Must name the origin exactly — the session
# cookie is credentialed, and browsers reject wildcard CORS origins on
# credentialed requests.
CORS_ORIGIN=http://localhost:5173

# Set to "production" in a real deploy. Controls whether the session cookie is
# marked Secure (which a plain-HTTP localhost dev server could never send back).
NODE_ENV=development

PORT=3000
SESSION_TTL_DAYS=30
LOG_LEVEL=info
